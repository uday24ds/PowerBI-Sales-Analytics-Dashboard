table Fact_Sales
	lineageTag: 0d4d61ba-caca-4174-a7ae-900bf388acb6

	measure 'Total Sales' = SUM(Fact_Sales[Calculated Total])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 51a0e39c-f52c-4199-b59e-6198e1153306

	measure 'Units Sold' = sum(Fact_Sales[Quantity])
		formatString: 0
		lineageTag: 8fb6a3ed-e479-4d5c-9842-3875150cfa3b

	measure 'Total Transactions' = DISTINCTCOUNT(Fact_Sales[Transaction ID])
		formatString: 0
		lineageTag: 554e72ae-165c-41a8-9684-c277a10d4dea

	measure 'Average Transaction Value' = DIVIDE([Total Sales], [Total Transactions])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: 228470ee-2d11-477b-9a73-daca4ca944ff

	measure 'Average Unit Price' = AVERAGE(Fact_Sales[Price Per Unit Final])
		formatString: \$#,0.00;(\$#,0.00);\$#,0.00
		lineageTag: c34fac65-23d0-433f-be7a-dbdd851ef15f

	measure 'Discounted Transactions' = CALCULATE([Total Transactions], Fact_Sales[Discount_Applied_Clean]= "true")
		formatString: 0
		lineageTag: cf625a1c-03d2-4867-9eff-d4d9c5ce0b5b

	measure 'Discount Rate' = ```
			
			DIVIDE(
			    [Discounted Transactions],
			    [Total Transactions]
			)
			
			```
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 7ae9289a-1b82-453d-9a37-e1e0ed193c0f

	measure 'Market Analysis' = "Sales Performance Dashboard- " & COALESCE(SELECTEDVALUE(Dim_Category[Category]), "All Categories") & " | " & COALESCE(SELECTEDVALUE(Dim_Location[Location]), "All Locations") & " | " & COALESCE(SELECTEDVALUE(Dim_Payment_Method[Payment Method]), "All Payment Methods")
		lineageTag: 2416d8d5-1ae2-4e9a-aed5-57a11122f1e9

	measure 'Previous Year Sales' =
			
			CALCULATE(
			    [Total Sales],
			    SAMEPERIODLASTYEAR(Dim_Date[Date]
			))
		lineageTag: a2add950-631b-4c4f-9460-c5087dd698a0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'YoY Sales Growth %' =
			
			DIVIDE(
			    [Total Sales] - [Previous Year Sales],
			    [Previous Year Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 5846a9dd-6fab-42fd-af28-ad6fa23b4854

	measure 'Previous Month Sales' = CALCULATE([Total Sales], DATEADD(Dim_Date[Date],-1,MONTH))
		lineageTag: 927de0fe-19f9-4661-9e06-4848e2f22fc7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'MoM Sales Growth %' =
			
			DIVIDE(
			    [Total Sales] - [Previous Month Sales],
			    [Previous Month Sales]
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 25e9c8fb-7c6c-488b-9f55-db395a83f3ea

	measure 'Customer Details Title' =
			
			"Customer Details | " &
			SELECTEDVALUE(
			    Dim_Customer[Customer ID],
			    "All Customers"
			)
		lineageTag: d5c44f0b-b84d-4616-b0e6-a202fcb02b1c

	measure 'Product Details Title' = "Product Details" & " | " & COALESCE(SELECTEDVALUE(Dim_Product[Item]),"All Products")
		lineageTag: 00989049-eb11-4e97-aceb-af0217974044

